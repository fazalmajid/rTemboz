_!WAOv!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7da218de-fd11-4f30-8e89-3122bc90f558_1344x642.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!WAOv!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7da218de-fd11-4f30-8e89-3122bc90f558_1344x642.jpeg 1456w" sizes="100vw"><img src="https://substackcdn.com/image/fetch/$s_!WAOv!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7da218de-fd11-4f30-8e89-3122bc90f558_1344x642.jpeg" width="1344" height="642" data-attrs="{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/7da218de-fd11-4f30-8e89-3122bc90f558_1344x642.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:642,&quot;width&quot;:1344,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:null,&quot;alt&quot;:&quot;&quot;,&quot;title&quot;:null,&quot;type&quot;:null,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:null,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}" class="sizing-normal" alt="" title="" srcset="https://substackcdn.com/image/fetch/$s_!WAOv!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7da218de-fd11-4f30-8e89-3122bc90f558_1344x642.jpeg 424w, https://substackcdn.com/image/fetch/$s_!WAOv!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7da218de-fd11-4f30-8e89-3122bc90f558_1344x642.jpeg 848w, https://substackcdn.com/image/fetch/$s_!WAOv!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7da218de-fd11-4f30-8e89-3122bc90f558_1344x642.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!WAOv!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7da218de-fd11-4f30-8e89-3122bc90f558_1344x642.jpeg 1456w" sizes="100vw" loading="lazy"></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button></div></div></div></a><figcaption class="image-caption"><em>(Photos by Mike Styczen)</em></figcaption></figure></div><p>I&#8217;m not a ref but I&#8217;m a curler. We do our own coin toss for hammer (i.e., who gets &#8220;last licks&#8221;) at the beginning of every game. I&#8217;ve kept the same <a href="https://en.wikipedia.org/wiki/Toonie">toonie</a> (shown above) in the zippered back pocket of my curling pants for a decade. I don&#8217;t even take it out when I wash the pants, so there&#8217;s always a coin.</p><p>But when there&#8217;s no coin for whatever reason, we use the stopwatch app on someone&#8217;s phone and play &#8220;odd/even.&#8221; You start the timer, one team calls &#8220;odd&#8221; or &#8220;even,&#8221; you stop the timer, and the last hundredths digit of the timer determines the winner.</p><div class="captioned-image-container"><figure><a class="image-link image2 is-viewable-img" target="_blank" href="https://substackcdn.com/image/fetch/$s_!vZ16!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F879b8798-8b7f-45df-b1e3-6b1fa3cff697_672x666.jpeg" data-component-name="Image2ToDOM"><div class="image2-inset"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!vZ16!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F879b8798-8b7f-45df-b1e3-6b1fa3cff697_672x666.jpeg 424w, https://substackcdn.com/image/fetch/$s_!vZ16!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F879b8798-8b7f-45df-b1e3-6b1fa3cff697_672x666.jpeg 848w, https://substackcdn.com/image/fetch/$s_!vZ16!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F879b8798-8b7f-45df-b1e3-6b1fa3cff697_672x666.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!vZ16!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F879b8798-8b7f-45df-b1e3-6b1fa3cff697_672x666.jpeg 1456w" sizes="100vw"><img src="https://substackcdn.com/image/fetch/$s_!vZ16!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F879b8798-8b7f-45df-b